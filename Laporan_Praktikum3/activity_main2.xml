<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <EditText android:id="@+id/edt_kehadiran"
        android:hint="Nilai Kehadiran"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <EditText android:id="@+id/edt_tugas"
        android:hint="Nilai Tugas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <EditText android:id="@+id/edt_uts"
        android:hint="Nilai UTS"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <EditText android:id="@+id/edt_uas"
        android:hint="Nilai UAS"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <Button
        android:text="SIMPAN"
        android:onClick="simpan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <Button
        android:text="BATAL"
        android:onClick="batal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

</LinearLayout>