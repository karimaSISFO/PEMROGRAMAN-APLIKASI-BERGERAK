<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hobi (Pilih lebih dari satu)"
        android:textColor="#FF5722"
        android:textColorHint="#F44336"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.179"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.189" />

    <TextView
        android:id="@+id/txtNama"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:inputType="text"
        android:hint="Nama Lengkap"
        tools:layout_editor_absoluteX="66dp"
        tools:layout_editor_absoluteY="49dp" />

    <TextView
        android:id="@+id/txtNim"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NIM"
        tools:layout_editor_absoluteX="65dp"
        tools:layout_editor_absoluteY="76dp" />

    <TextView
        android:id="@+id/txtEmail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Email"
        tools:layout_editor_absoluteX="65dp"
        tools:layout_editor_absoluteY="103dp" />

    <CheckBox
        android:id="@+id/cbMembaca"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Membaca"
        tools:layout_editor_absoluteX="74dp"
        tools:layout_editor_absoluteY="170dp" />

    <CheckBox
        android:id="@+id/cbOlahraga"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Olahraga"
        tools:layout_editor_absoluteX="74dp"
        tools:layout_editor_absoluteY="245dp" />

    <CheckBox
        android:id="@+id/cbPerempuan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Perempuan"
        tools:layout_editor_absoluteX="251dp"
        tools:layout_editor_absoluteY="170dp" />

    <CheckBox
        android:id="@+id/cbMusik"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Musik"
        tools:layout_editor_absoluteX="251dp"
        tools:layout_editor_absoluteY="245dp" />

    <TextView
        android:id="@+id/textView5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Jenis Kelamin"
        android:textColor="#FF5722"
        android:textStyle="bold"
        tools:layout_editor_absoluteX="51dp"
        tools:layout_editor_absoluteY="301dp" />

    <RadioGroup
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:layout_editor_absoluteX="76dp"
        tools:layout_editor_absoluteY="332dp">

        <RadioButton
            android:id="@+id/rbLaki"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Laki-laki" />

        <RadioButton
            android:id="@+id/rbPerempuan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Perempuan" />
    </RadioGroup>

    <TextView
        android:id="@+id/textView6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="program Studi"
        android:textColor="#FF5722"
        android:textStyle="bold"
        tools:layout_editor_absoluteX="50dp"
        tools:layout_editor_absoluteY="447dp" />

    <Spinner
        android:id="@+id/spinner"
        android:layout_width="223dp"
        android:layout_height="28dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.393"
        app:layout_constraintStart_toStartOf="parent"
        tools:layout_editor_absoluteY="487dp" />

    <Button
        android:id="@+id/btnSubmit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tampilkan Data"
        tools:layout_editor_absoluteX="63dp"
        tools:layout_editor_absoluteY="543dp" />

    <Button
        android:id="@+id/btnreset"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="63dp"
        android:backgroundTint="#F44336"
        android:text="Reset  Form"
        android:textColorLink="#F44336"
        app:layout_constraintEnd_toEndOf="parent"
        tools:layout_editor_absoluteY="543dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <EditText
            android:id="@+id/editTextText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ems="20"
            android:inputType="text"
            android:text="Form Data Mahasiswa"
            android:textColor="#3F51B5"
            android:textColorHint="#3F51B5"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            tools:layout_editor_absoluteX="138dp"
            tools:layout_editor_absoluteY="4dp" />

    </LinearLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

    </com.google.android.material.textfield.TextInputLayout>


</androidx.constraintlayout.widget.ConstraintLayout>